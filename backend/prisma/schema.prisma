// Prisma Schema for MID TRACK – SRKR Engineering College Mid Marks Management System
// Relational Database Schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Users Table (Authentication & Identity)
model User {
  id           String    @id @default(uuid())
  username     String    @unique // Faculty EMPID or Student Register Number
  passwordHash String    @map("password_hash")
  role         String    @default("STUDENT") // "FACULTY" or "STUDENT" (Strictly No Super Admin)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // 1-to-1 Relations with Profile Tables
  facultyProfile Faculty?
  studentProfile Student?

  @@map("users")
}

// 2. Faculty Table
model Faculty {
  id         String   @id @default(uuid())
  userId     String   @unique @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facultyId  String   @unique @map("faculty_id") // Unique EMPID assigned by SRKR (e.g. "780", "781")
  name       String   // Full Name (e.g., Dr. M SURESH BABU, Dr. N G K MURTHY)
  department String?  // Department/Branch (e.g. "CSD", "CSIT")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  // Relations
  marksEntered Mark[]
  allocations  FacultyAllocation[]

  @@map("faculty")
}

// 3. Students Table
model Student {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  registerNumber String   @unique @map("register_number") // Unique Register No (e.g. "24B91A0701")
  name           String   // Full Student Name
  branch         String   // Branch (e.g., "CSD", "CSIT")
  section        String   // Section Name (e.g., "CSD", "CSIT", "CSIT-A", "CSIT-B")
  academicYear   String   @map("academic_year") // e.g. "2025-2026"
  semester       Int      // Semester (1 to 8, e.g. 2, 4, 6)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  marks Mark[]

  @@index([branch, section, semester, academicYear])
  @@map("students")
}

// 4. Sections Table
model Section {
  id           String   @id @default(uuid())
  sectionName  String   @map("section_name") // e.g., "CSD", "CSIT", "CSIT-A", "CSIT-B"
  branch       String   // e.g., "CSD", "CSIT"
  academicYear String   @map("academic_year") // e.g., "2025-2026"
  semester     Int      // Semester (e.g. 2, 4, 6)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  marks       Mark[]
  allocations FacultyAllocation[]

  @@unique([sectionName, branch, academicYear, semester], name: "section_composite_unique")
  @@map("sections")
}

// 5. Subjects Table
model Subject {
  id          String   @id @default(uuid())
  subjectCode String   @map("subject_code") // e.g., "CS301", "CS302"
  subjectName String   @map("subject_name") // e.g., "Computer Networks", "DBMS"
  branch      String   // e.g., "CSD", "CSIT"
  semester    Int      // Semester (1 to 8)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  marks       Mark[]
  allocations FacultyAllocation[]

  @@unique([subjectCode, branch, semester], name: "subject_composite_unique")
  @@map("subjects")
}

// 6. Exams Table
model Exam {
  id           String   @id @default(uuid())
  examType     String   @map("exam_name") // "MID_1" or "MID_2"
  academicYear String   @map("academic_year") // e.g., "2025-2026"
  semester     Int      // Semester (1 to 8)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  marks Mark[]

  @@unique([examType, academicYear, semester], name: "exam_composite_unique")
  @@map("exams")
}

// 7. Marks Table (Question-wise Descriptive, Objective, Assignment & Grand Total)
model Mark {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  facultyId String?  @map("faculty_id")
  faculty   Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  subjectId String   @map("subject_id")
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  sectionId String   @map("section_id")
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  examId    String   @map("exam_id")
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  // DESCRIPTIVE QUESTIONS (Choice pairs: Q1/Q2, Q3/Q4, Q5/Q6; Max 5 marks each)
  descriptiveQ1OrQ2 Float?   @default(0) @map("descriptive_q1_or_q2")
  descriptiveQ3OrQ4 Float?   @default(0) @map("descriptive_q3_or_q4")
  descriptiveQ5OrQ6 Float?   @default(0) @map("descriptive_q5_or_q6")
  descriptiveTotal  Float    @default(0) @map("descriptive_total") // Max 15

  // OBJECTIVE QUESTIONS (5 questions @ 2 marks each; Max 2 marks each)
  objectiveQ1 Float?   @default(0) @map("objective_q1")
  objectiveQ2 Float?   @default(0) @map("objective_q2")
  objectiveQ3 Float?   @default(0) @map("objective_q3")
  objectiveQ4 Float?   @default(0) @map("objective_q4")
  objectiveQ5 Float?   @default(0) @map("objective_q5")
  objectiveTotal Float  @default(0) @map("objective_total") // Max 10

  // CONTINUOUS EVALUATION ASSIGNMENT (Max 5 marks)
  assignmentMarks Float @default(0) @map("assignment_marks")

  // GRAND TOTAL (Descriptive 15 + Objective 10 + Assignment 5 = Max 30)
  total Float @default(0) @map("total")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Constraints: Exactly 1 record per student per subject per exam (allows updates without duplication)
  @@unique([studentId, subjectId, examId], name: "student_subject_exam_unique")
  @@index([sectionId, subjectId, examId])
  @@map("marks")
}

// 8. Academic Years Table
model AcademicYear {
  id        String     @id @default(uuid())
  year      String     @unique // e.g., "2025-2026", "2026-2027"
  isCurrent Boolean    @default(false) @map("is_current")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  semesters Semester[]

  @@map("academic_years")
}

// 9. Semesters Table
model Semester {
  id             String              @id @default(uuid())
  academicYearId String              @map("academic_year_id")
  academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  semesterNumber Int                 @map("semester_number") // 1 to 8
  name           String              // e.g., "II B.Tech I Semester (Sem 3)"
  isActive       Boolean             @default(false) @map("is_active")
  startDate      DateTime?           @map("start_date")
  endDate        DateTime?           @map("end_date")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  allocations    FacultyAllocation[]

  @@unique([academicYearId, semesterNumber], name: "academic_year_semester_unique")
  @@map("semesters")
}

// 10. Faculty Allocations Table (Semester-wise Subject & Section Assignment)
model FacultyAllocation {
  id             String    @id @default(uuid())
  academicYear   String    @map("academic_year") // e.g. "2026-2027"
  semesterNumber Int       @map("semester_number") // 1 to 8 (e.g. 3, 5, 7)
  branch         String    // "CSIT", "CSD"
  sectionId      String    @map("section_id")
  section        Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId      String    @map("subject_id")
  subject        Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  facultyId      String    @map("faculty_id")
  faculty        Faculty   @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  semesterId     String?   @map("semester_id")
  semester       Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  isPrimary      Boolean   @default(true) @map("is_primary")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([sectionId, subjectId, facultyId], name: "section_subject_faculty_unique")
  @@index([academicYear, semesterNumber, branch])
  @@index([facultyId, isActive])
  @@index([sectionId, isActive])
  @@map("faculty_allocations")
}

